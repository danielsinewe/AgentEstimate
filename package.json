{
  "name": "agent-estimate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@agent-eta/web",
    "build": "npm run build --workspace=@agent-eta/core && npm run build --workspace=@agent-eta/integration && npm run build --workspace=@agent-eta/web",
    "build:web": "npm run build --workspace=@agent-eta/core && npm run build --workspace=@agent-eta/web",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "typecheck": "tsc -b",
    "lint": "oxlint . --ignore-pattern 'plugins/agent-eta/dist/**' --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "plugin:validate": "node scripts/validate-plugin.mjs",
    "plugin:smoke": "node scripts/smoke-plugin.mjs",
    "preview": "npm run preview --workspace=@agent-eta/web"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
